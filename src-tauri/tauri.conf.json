{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "../package.json",
  "identifier": "com.nekocode.dsh-desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "npm run prebuild"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwNUU0Q0ZGNTAxNjg4NTYKUldSV2lCWlEvMHhlVUxLRXE3cE12QlBHQitoN2JUa1NjNG92akViWVpac1JpY1JKY0FYK0FKRXAK",
      "endpoints": ["https://dsh-desktop.xiu.ai/updates/{{target}}-{{arch}}.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns"],
    "externalBin": ["binaries/dsh-runtime"],
    "resources": {
      "../build/backend": "backend"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    }
  }
}
