{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal DeepSeek Harness desktop app for macOS",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types scripts/**/*.test.ts",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:backend": "node --experimental-strip-types scripts/build-backend.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "app:build": "tauri build",
    "app:dev": "tauri dev",
    "stage:runtime": "node --experimental-strip-types scripts/stage-runtime.ts",
    "prebuild": "npm run build:backend && npm run stage:runtime && npm run smoke",
    "check": "npm run typecheck && npm run format:check && npm test && npm run lint:rust && npm run test:rust",
    "icon": "node --experimental-strip-types scripts/make-icon.ts",
    "deploy:dist": "wrangler deploy --profile ${WRANGLER_PROFILE:-xiu}"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.10.1",
    "@vercel/nft": "^0.30.1",
    "js-yaml": "^4.1.0",
    "prettier": "^3.6.2",
    "ripgrep": "0.3.1",
    "typescript": "^5.9.3"
  }
}
